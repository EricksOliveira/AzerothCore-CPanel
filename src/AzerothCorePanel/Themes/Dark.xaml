<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors of the dark theme. Same keys as Light.xaml. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#323232" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#383838" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#444444" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#505050" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#363636" />
  <SolidColorBrush x:Key="TextBrush" Color="#ECECEC" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#A2A2A2" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#6C6C6C" />
  <SolidColorBrush x:Key="AccentBrush" Color="#E04646" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2E4A66" />
  <SolidColorBrush x:Key="ModifiedRowBrush" Color="#4A3E1C" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A5A5A" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#787878" />
  <SolidColorBrush x:Key="LogBackgroundBrush" Color="#161616" />
  <SolidColorBrush x:Key="LogTextBrush" Color="#DCDCDC" />

  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1F1F1F" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A2A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6C6C6C" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2E4A66" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#ECECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3A3A3A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#ECECEC" />
</ResourceDictionary>
