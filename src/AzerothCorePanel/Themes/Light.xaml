<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colors of the light theme. Controls.xaml uses these keys with DynamicResource. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E9E9E9" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#DCDCDC" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="#CACACA" />
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#C2C2C2" />
  <SolidColorBrush x:Key="GridLineBrush" Color="#E6E6E6" />
  <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#6A6A6A" />
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#A3A3A3" />
  <SolidColorBrush x:Key="AccentBrush" Color="#C62828" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#D6E7F8" />
  <SolidColorBrush x:Key="ModifiedRowBrush" Color="#FFF1CC" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C4C4" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6A6A6" />
  <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1E1E1E" />
  <SolidColorBrush x:Key="LogTextBrush" Color="#DCDCDC" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E1E1" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E3E" />
  <SolidColorBrush x:Key="SuccessHoverBrush" Color="#18773A" />
  <SolidColorBrush x:Key="DangerBrush" Color="#D93025" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="#B8261D" />
  <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#E6E6E6" />

  <!-- System colors still used by a few built-in parts (ScrollViewer corner, DataGrid focus, ...). -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F3F3F3" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1B1B1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1B1B1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#A3A3A3" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D6E7F8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1B1B1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5E5E5" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1B1B1B" />
</ResourceDictionary>
