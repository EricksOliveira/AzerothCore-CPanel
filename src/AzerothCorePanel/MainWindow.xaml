<Window x:Class="AzerothCorePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzerothCore CPanel"
        Icon="Assets/app.ico"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style x:Key="LogBoxStyle" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="Foreground" Value="#DCDCDC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Server folder -->
    <GroupBox Grid.Row="0" Header="Servidor (pasta da Build ou do Repack)" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="0" IsReadOnly="True"
                 VerticalContentAlignment="Center" Padding="4,3" />
        <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0"
                Content="Procurar..." Click="BrowseButton_Click" />

        <TextBlock x:Name="AuthPathText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="WorldPathText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
          <CheckBox x:Name="StartWithWindowsCheck" VerticalAlignment="Center"
                    Content="Iniciar o painel com o Windows"
                    ToolTip="Abre o painel quando você entra no Windows, já na bandeja do sistema."
                    Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed" />
          <CheckBox x:Name="StartServersOnAutostartCheck" VerticalAlignment="Center" Margin="20,0,0,0"
                    Content="E iniciar os servidores"
                    ToolTip="Quando o painel abrir com o Windows, espera o MySQL ficar pronto e inicia os servidores."
                    Checked="StartServersOnAutostartCheck_Changed" Unchecked="StartServersOnAutostartCheck_Changed" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- Controls and status -->
    <DockPanel Grid.Row="1" Margin="0,12,0,12" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="StartButton" Content="▶ Start" Click="StartButton_Click" />
        <Button x:Name="StopButton" Content="■ Stop" Margin="8,0,0,0" Click="StopButton_Click" />
        <Button x:Name="RestartButton" Content="⟳ Restart" Margin="8,0,0,0" Click="RestartButton_Click" />
      </StackPanel>

      <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MinWidth="240" />
          <ColumnDefinition Width="Auto" MinWidth="80" />
          <ColumnDefinition Width="Auto" MinWidth="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,1,0,1" />
            <Setter Property="Foreground" Value="Gray" />
          </Style>
        </Grid.Resources>

        <Ellipse x:Name="WorldDot" Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="WorldStatusText" Grid.Row="0" Grid.Column="1" Margin="6,1,0,1" VerticalAlignment="Center"
                   Text="Worldserver: Parado" />
        <TextBlock x:Name="WorldCpuText" Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricText}"
                   Text="CPU —" ToolTip="Uso de CPU somando todos os núcleos (como no Gerenciador de Tarefas)" />
        <TextBlock x:Name="WorldRamText" Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricText}"
                   Text="RAM —" />

        <Ellipse x:Name="AuthDot" Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="AuthStatusText" Grid.Row="1" Grid.Column="1" Margin="6,1,0,1" VerticalAlignment="Center"
                   Text="Authserver: Parado" />
        <TextBlock x:Name="AuthCpuText" Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricText}"
                   Text="CPU —" ToolTip="Uso de CPU somando todos os núcleos (como no Gerenciador de Tarefas)" />
        <TextBlock x:Name="AuthRamText" Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricText}"
                   Text="RAM —" />
      </Grid>
    </DockPanel>

    <!-- Logs -->
    <TabControl Grid.Row="2">
      <TabItem Header="Worldserver">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="SendCommandButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Content="Enviar" Click="SendCommandButton_Click" />
            <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,3"
                     KeyDown="CommandBox_KeyDown"
                     ToolTip="Comando do console do worldserver, por exemplo: server info" />
          </DockPanel>
          <TextBox x:Name="WorldLogBox" Style="{StaticResource LogBoxStyle}" />
        </DockPanel>
      </TabItem>
      <TabItem Header="Authserver">
        <TextBox x:Name="AuthLogBox" Style="{StaticResource LogBoxStyle}" />
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <CheckBox x:Name="AutoScrollCheck" DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="True"
                Content="Rolar automaticamente" Checked="AutoScrollCheck_Changed" Unchecked="AutoScrollCheck_Changed" />
      <CheckBox x:Name="AutoRestartCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="Reiniciar servidor se cair"
                Checked="AutoRestartCheck_Changed" Unchecked="AutoRestartCheck_Changed" />
      <CheckBox x:Name="MinimizeToTrayCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="Minimizar para a bandeja"
                ToolTip="Ao minimizar, o painel sai da barra de tarefas e fica no ícone perto do relógio."
                Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed" />
      <Button DockPanel.Dock="Right" Content="Limpar logs" Click="ClearLogsButton_Click" />
      <TextBlock />
    </DockPanel>
  </Grid>
</Window>
