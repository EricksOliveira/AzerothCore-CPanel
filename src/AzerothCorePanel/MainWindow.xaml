<Window x:Class="AzerothCorePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzerothCore CPanel"
        Icon="Assets/app.ico"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style x:Key="LogBoxStyle" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#1E1E1E" />
      <Setter Property="Foreground" Value="#DCDCDC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Server folder -->
    <GroupBox Grid.Row="0" Header="Servidor (pasta da Build ou do Repack)" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="0" IsReadOnly="True"
                 VerticalContentAlignment="Center" Padding="4,3" />
        <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0"
                Content="Procurar..." Click="BrowseButton_Click" />

        <TextBlock x:Name="AuthPathText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="WorldPathText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,2,0,0"
                   Foreground="Gray" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
          <CheckBox x:Name="StartWithWindowsCheck" VerticalAlignment="Center"
                    Content="Iniciar o painel com o Windows"
                    ToolTip="Abre o painel quando você entra no Windows, já na bandeja do sistema."
                    Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed" />
          <CheckBox x:Name="StartServersOnAutostartCheck" VerticalAlignment="Center" Margin="20,0,0,0"
                    Content="E iniciar os servidores"
                    ToolTip="Quando o painel abrir com o Windows, espera o MySQL ficar pronto e inicia os servidores."
                    Checked="StartServersOnAutostartCheck_Changed" Unchecked="StartServersOnAutostartCheck_Changed" />
          <CheckBox x:Name="StartMySqlWithServersCheck" VerticalAlignment="Center" Margin="20,0,0,0"
                    Content="Iniciar o MySQL junto com os servidores"
                    ToolTip="Se o MySQL estiver parado, o Start inicia ele primeiro e espera ficar pronto."
                    Checked="StartMySqlWithServersCheck_Changed" Unchecked="StartMySqlWithServersCheck_Changed" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- Controls and status -->
    <DockPanel Grid.Row="1" Margin="0,12,0,12" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="StartButton" Content="▶ Start" Click="StartButton_Click" />
        <Button x:Name="StopButton" Content="■ Stop" Margin="8,0,0,0" Click="StopButton_Click" />
        <Button x:Name="RestartButton" Content="⟳ Restart" Margin="8,0,0,0" Click="RestartButton_Click" />
      </StackPanel>

      <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" MinWidth="240" />
          <ColumnDefinition Width="Auto" MinWidth="80" />
          <ColumnDefinition Width="Auto" MinWidth="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style x:Key="MetricText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,1,0,1" />
            <Setter Property="Foreground" Value="Gray" />
          </Style>
        </Grid.Resources>

        <Ellipse x:Name="WorldDot" Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="WorldStatusText" Grid.Row="0" Grid.Column="1" Margin="6,1,0,1" VerticalAlignment="Center"
                   Text="Worldserver: Parado" />
        <TextBlock x:Name="WorldCpuText" Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricText}"
                   Text="CPU —" ToolTip="Uso de CPU somando todos os núcleos (como no Gerenciador de Tarefas)" />
        <TextBlock x:Name="WorldRamText" Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricText}"
                   Text="RAM —" />

        <Ellipse x:Name="AuthDot" Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="AuthStatusText" Grid.Row="1" Grid.Column="1" Margin="6,1,0,1" VerticalAlignment="Center"
                   Text="Authserver: Parado" />
        <TextBlock x:Name="AuthCpuText" Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricText}"
                   Text="CPU —" ToolTip="Uso de CPU somando todos os núcleos (como no Gerenciador de Tarefas)" />
        <TextBlock x:Name="AuthRamText" Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricText}"
                   Text="RAM —" />

        <Ellipse x:Name="MySqlDot" Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="Gray"
                 VerticalAlignment="Center" />
        <TextBlock x:Name="MySqlStatusText" Grid.Row="2" Grid.Column="1" Margin="6,1,0,1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="300" Text="MySQL: —" />
        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,1,0,1">
          <Button x:Name="MySqlStartButton" Content="Iniciar" Padding="8,0" MinWidth="0"
                  Click="MySqlStartButton_Click" ToolTip="Inicia o MySQL" />
          <Button x:Name="MySqlStopButton" Content="Parar" Padding="8,0" MinWidth="0" Margin="6,0,0,0"
                  Click="MySqlStopButton_Click" />
        </StackPanel>

        <TextBlock x:Name="PlayersStatusText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,1,0,1"
                   VerticalAlignment="Center" Text="Jogadores online: —" />
      </Grid>
    </DockPanel>

    <!-- Logs -->
    <TabControl Grid.Row="2">
      <TabItem Header="Worldserver">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="SendCommandButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Content="Enviar" Click="SendCommandButton_Click" />
            <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,3"
                     KeyDown="CommandBox_KeyDown"
                     ToolTip="Comando do console do worldserver, por exemplo: server info" />
          </DockPanel>
          <TextBox x:Name="WorldLogBox" Style="{StaticResource LogBoxStyle}" />
        </DockPanel>
      </TabItem>
      <TabItem x:Name="PlayersTab" Header="Jogadores">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Atualizar" Click="RefreshPlayersButton_Click" />
            <TextBlock x:Name="PlayersInfoText" VerticalAlignment="Center" Text="O worldserver não está rodando." />
          </DockPanel>
          <DataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Expulsar do jogo (kick, via SOAP)" Click="KickPlayerMenu_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Nível" Binding="{Binding Level}" Width="Auto" />
              <DataGridTextColumn Header="Raça" Binding="{Binding RaceName}" Width="*" />
              <DataGridTextColumn Header="Classe" Binding="{Binding ClassName}" Width="*" />
              <DataGridTextColumn Header="Facção" Binding="{Binding Faction}" Width="Auto" />
              <DataGridTextColumn Header="Mapa" Binding="{Binding MapName}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="GmTab" Header="Comandos GM">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,8"
                  Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <Button x:Name="EnableSoapButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Content="Ativar SOAP no worldserver.conf" Click="EnableSoapButton_Click" />
                <TextBlock x:Name="SoapStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Conta GM:" VerticalAlignment="Center" />
                <TextBox x:Name="SoapUserBox" Width="160" Margin="6,0,0,0" Padding="3,2"
                         VerticalContentAlignment="Center"
                         ToolTip="Conta do jogo com GM nível 3 (administrador)" />
                <TextBlock Text="Senha:" VerticalAlignment="Center" Margin="16,0,0,0" />
                <PasswordBox x:Name="SoapPasswordBox" Width="160" Margin="6,0,0,0" Padding="3,2"
                             VerticalContentAlignment="Center" />
                <Button Content="Salvar" Margin="12,0,0,0" Click="SaveSoapButton_Click"
                        ToolTip="Guarda a conta e a senha (a senha fica criptografada para o seu usuário do Windows)" />
                <Button Content="Testar" Margin="8,0,0,0" Tag="run:server info" Click="GmQuickButton_Click"
                        ToolTip="Executa 'server info' pelo SOAP" />
              </StackPanel>
              <WrapPanel Margin="0,8,0,0">
                <WrapPanel.Resources>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,4" />
                    <Setter Property="Padding" Value="10,3" />
                    <Setter Property="MinWidth" Value="0" />
                  </Style>
                </WrapPanel.Resources>
                <Button Content="Info do servidor" Tag="run:server info" Click="GmQuickButton_Click" />
                <Button Content="Salvar personagens" Tag="run:saveall" Click="GmQuickButton_Click" />
                <Button Content="Anunciar..." Tag="fill:announce " Click="GmQuickButton_Click"
                        ToolTip="announce &lt;mensagem&gt; — mensagem para todos os jogadores" />
                <Button Content="Expulsar..." Tag="fill:kick " Click="GmQuickButton_Click"
                        ToolTip="kick &lt;personagem&gt;" />
                <Button Content="Criar conta..." Tag="fill:account create " Click="GmQuickButton_Click"
                        ToolTip="account create &lt;usuário&gt; &lt;senha&gt;" />
                <Button Content="Dar GM..." Tag="fill:account set gmlevel " Click="GmQuickButton_Click"
                        ToolTip="account set gmlevel &lt;usuário&gt; &lt;nível 0-3&gt; -1   (-1 = todos os realms)" />
                <Button Content="Recarregar config" Tag="run:reload config" Click="GmQuickButton_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="GmRunButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Executar"
                    Click="GmRunButton_Click" />
            <TextBox x:Name="GmCommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,3"
                     PreviewKeyDown="GmCommandBox_PreviewKeyDown"
                     ToolTip="Comando GM sem o ponto, por exemplo: server info. Setas para cima e para baixo: histórico." />
          </DockPanel>

          <TextBox x:Name="GmOutputBox" Style="{StaticResource LogBoxStyle}" TextWrapping="Wrap" />
        </DockPanel>
      </TabItem>
      <TabItem Header="Authserver">
        <TextBox x:Name="AuthLogBox" Style="{StaticResource LogBoxStyle}" />
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,8,0,0">
      <CheckBox x:Name="AutoScrollCheck" DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="True"
                Content="Rolar automaticamente" Checked="AutoScrollCheck_Changed" Unchecked="AutoScrollCheck_Changed" />
      <CheckBox x:Name="AutoRestartCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="Reiniciar servidor se cair"
                Checked="AutoRestartCheck_Changed" Unchecked="AutoRestartCheck_Changed" />
      <CheckBox x:Name="MinimizeToTrayCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="Minimizar para a bandeja"
                ToolTip="Ao minimizar, o painel sai da barra de tarefas e fica no ícone perto do relógio."
                Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed" />
      <Button DockPanel.Dock="Right" Content="Limpar logs" Click="ClearLogsButton_Click" />
      <TextBlock />
    </DockPanel>
  </Grid>
</Window>
