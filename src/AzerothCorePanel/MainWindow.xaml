<Window x:Class="AzerothCorePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzerothCore CPanel"
        Width="900" Height="600"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="StartButton" Content="Start" Width="100" Margin="0,0,8,0" IsEnabled="False" />
      <Button x:Name="StopButton" Content="Stop" Width="100" Margin="0,0,8,0" IsEnabled="False" />
      <Button x:Name="RestartButton" Content="Restart" Width="100" IsEnabled="False" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="Logs" FontWeight="SemiBold" Margin="0,0,0,4" />

    <TextBox x:Name="LogBox"
             IsReadOnly="True"
             FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"
             Text="Em desenvolvimento." />
  </DockPanel>
</Window>
