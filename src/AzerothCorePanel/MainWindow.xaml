<Window x:Class="AzerothCorePanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AzerothCorePanel.Views"
        xmlns:l="clr-namespace:AzerothCorePanel.Localization"
        Title="AzerothCore CPanel"
        Icon="Assets/app.ico"
        Width="1120" Height="800"
        MinWidth="980" MinHeight="660"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- BasedOn keeps the theme's template (Themes/Controls.xaml) and only changes the size here. -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <Style x:Key="LogBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Style.Resources>
        <!-- Corner between the two scroll bars: same dark color as the log, in both themes. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1A1A1A" />
      </Style.Resources>
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource LogTextBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource LogTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Number of errors next to a log tab's name -->
    <Style x:Key="ErrorBadge" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="{l:Tr Logs.ErrorBadge.Tip}" />
      <Style.Resources>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="White" />
          <Setter Property="FontSize" Value="11" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
      </Style.Resources>
    </Style>

    <Style x:Key="TileTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>
    <Style x:Key="StatusDot" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Fill" Value="Gray" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <!-- Start/Stop buttons on each status tile. -->
    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <!-- Icon inside a button, drawn with the button's text color (white on filled buttons). -->
    <Style x:Key="ButtonIcon" TargetType="Path">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>
    <Style x:Key="MainButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid Margin="16,12,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: logo and name on the left, language and theme on the right -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="LanguageButton" Style="{StaticResource FlatButton}" MinWidth="0"
                Click="LanguageButton_Click" ToolTip="{l:Tr Language.Tip}">
          <StackPanel Orientation="Horizontal">
            <Image x:Name="LanguageFlag" Width="20" Height="14" Source="{StaticResource Flag.en}" />
            <TextBlock x:Name="LanguageCode" Margin="6,0,4,0" VerticalAlignment="Center" Text="EN"
                       FontWeight="SemiBold" />
            <TextBlock Text="▾" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu x:Name="LanguageMenu" Placement="Bottom">
              <MenuItem Tag="en" Click="LanguageMenuItem_Click">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="14" Source="{StaticResource Flag.en}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="EN — English" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Tag="pt" Click="LanguageMenuItem_Click">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="14" Source="{StaticResource Flag.pt}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="PT — Português" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Tag="es" Click="LanguageMenuItem_Click">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="14" Source="{StaticResource Flag.es}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="ES — Español" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>

        <!-- Theme: sun = light, moon = dark -->
        <Border Margin="10,0,0,0" CornerRadius="6" Background="{DynamicResource SegmentBackgroundBrush}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeLightButton" GroupName="Theme" Style="{StaticResource SegmentRadio}"
                         ToolTip="{l:Tr Theme.Light}" Checked="ThemeButton_Checked">
              <Path Data="{StaticResource Icon.Sun}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </RadioButton>
            <RadioButton x:Name="ThemeDarkButton" GroupName="Theme" Style="{StaticResource SegmentRadio}"
                         ToolTip="{l:Tr Theme.Dark}" Checked="ThemeButton_Checked">
              <Path Data="{StaticResource Icon.Moon}" Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            </RadioButton>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{StaticResource Logo}" Width="40" Height="27" />
        <TextBlock Text="AzerothCore CPanel" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Style="{StaticResource SubtleText}" Margin="10,0,0,2"
                   VerticalAlignment="Bottom" />
      </StackPanel>
    </DockPanel>

    <!-- Server: folder, start options and the main buttons -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{l:Tr Main.ServerGroup}" Style="{StaticResource TileTitle}" />
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Content="{l:Tr Common.Browse}" Click="BrowseButton_Click" />
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="6,4" />
          </DockPanel>
          <TextBlock x:Name="AuthPathText" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
          <TextBlock x:Name="WorldPathText" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
          <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox x:Name="StartWithWindowsCheck" VerticalAlignment="Center" Margin="0,0,20,0"
                      Content="{l:Tr Main.StartWithWindows}" ToolTip="{l:Tr Main.StartWithWindows.Tip}"
                      Checked="StartWithWindowsCheck_Changed" Unchecked="StartWithWindowsCheck_Changed" />
            <CheckBox x:Name="StartServersOnAutostartCheck" VerticalAlignment="Center" Margin="0,0,20,0"
                      Content="{l:Tr Main.StartServersOnAutostart}" ToolTip="{l:Tr Main.StartServersOnAutostart.Tip}"
                      Checked="StartServersOnAutostartCheck_Changed" Unchecked="StartServersOnAutostartCheck_Changed" />
            <CheckBox x:Name="StartMySqlWithServersCheck" VerticalAlignment="Center"
                      Content="{l:Tr Main.StartMySql}" ToolTip="{l:Tr Main.StartMySql.Tip}"
                      Checked="StartMySqlWithServersCheck_Changed" Unchecked="StartMySqlWithServersCheck_Changed" />
          </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
          <Button x:Name="StartButton" Style="{StaticResource SuccessButton}" Padding="16,8" MinWidth="112"
                  Click="StartButton_Click" ToolTip="{l:Tr Main.Start.Tip}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Play}" Style="{StaticResource ButtonIcon}" />
              <TextBlock Text="{l:Tr Main.Start}" />
            </StackPanel>
          </Button>
          <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Padding="16,8" MinWidth="112"
                  Margin="8,0,0,0" Click="StopButton_Click" ToolTip="{l:Tr Main.Stop.Tip}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Stop}" Style="{StaticResource ButtonIcon}" />
              <TextBlock Text="{l:Tr Main.Stop}" />
            </StackPanel>
          </Button>
          <Button x:Name="RestartButton" Style="{StaticResource MainButton}" Click="RestartButton_Click"
                  ToolTip="{l:Tr Main.Restart.Tip}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Restart}" Style="{StaticResource ButtonIcon}" />
              <TextBlock Text="{l:Tr Main.Restart}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status tiles -->
    <UniformGrid Grid.Row="2" Columns="4" Margin="0,12,0,12">
      <Border Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="WorldDot" Style="{StaticResource StatusDot}" />
            <TextBlock Text="Worldserver" Style="{StaticResource TileTitle}" />
          </StackPanel>
          <TextBlock x:Name="WorldStatusText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="WorldCpuText" Style="{StaticResource MetricText}" Text="CPU —"
                       ToolTip="{l:Tr Main.Cpu.Tip}" />
            <TextBlock x:Name="WorldRamText" Style="{StaticResource MetricText}" Text="RAM —" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="WorldStartButton" Style="{StaticResource RowButton}" Content="{l:Tr Server.Start}"
                    Click="WorldStartButton_Click" />
            <Button x:Name="WorldStopButton" Style="{StaticResource RowButton}" Content="{l:Tr Server.Stop}"
                    Click="WorldStopButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="AuthDot" Style="{StaticResource StatusDot}" />
            <TextBlock Text="Authserver" Style="{StaticResource TileTitle}" />
          </StackPanel>
          <TextBlock x:Name="AuthStatusText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock x:Name="AuthCpuText" Style="{StaticResource MetricText}" Text="CPU —"
                       ToolTip="{l:Tr Main.Cpu.Tip}" />
            <TextBlock x:Name="AuthRamText" Style="{StaticResource MetricText}" Text="RAM —" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="AuthStartButton" Style="{StaticResource RowButton}" Content="{l:Tr Server.Start}"
                    Click="AuthStartButton_Click" />
            <Button x:Name="AuthStopButton" Style="{StaticResource RowButton}" Content="{l:Tr Server.Stop}"
                    Click="AuthStopButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,0,10,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="MySqlDot" Style="{StaticResource StatusDot}" />
            <TextBlock Text="MySQL" Style="{StaticResource TileTitle}" />
          </StackPanel>
          <TextBlock x:Name="MySqlStatusText" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text="—" />
          <TextBlock x:Name="MySqlDetailText" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="MySqlStartButton" Style="{StaticResource RowButton}" Content="{l:Tr MySql.Start}"
                    Click="MySqlStartButton_Click" ToolTip="{l:Tr MySql.Start.Tip}" />
            <Button x:Name="MySqlStopButton" Style="{StaticResource RowButton}" Content="{l:Tr MySql.Stop}"
                    Click="MySqlStopButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:Tr Tile.Players}" Style="{StaticResource TileTitle}" />
          <TextBlock x:Name="PlayersCountText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0" />
          <TextBlock x:Name="PlayersFactionText" Style="{StaticResource SubtleText}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Logs and tools -->
    <TabControl Grid.Row="3">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Worldserver" />
            <Border Style="{StaticResource ErrorBadge}"
                    Visibility="{Binding HasErrors, ElementName=WorldLogView, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding ErrorCount, ElementName=WorldLogView}" />
            </Border>
          </StackPanel>
        </TabItem.Header>
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="SendCommandButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Content="{l:Tr Console.Send}" Click="SendCommandButton_Click" />
            <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,3"
                     KeyDown="CommandBox_KeyDown" ToolTip="{l:Tr Console.Tip}" />
          </DockPanel>
          <views:LogView x:Name="WorldLogView" FileBaseName="worldserver" />
        </DockPanel>
      </TabItem>
      <TabItem x:Name="PlayersTab" Header="{l:Tr Tab.Players}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{l:Tr Common.Refresh}" Click="RefreshPlayersButton_Click" />
            <TextBlock x:Name="PlayersInfoText" VerticalAlignment="Center" />
          </DockPanel>
          <DataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{l:Tr Players.Kick}" Click="KickPlayerMenu_Click" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="{l:Tr Col.Name}" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="{l:Tr Col.Level}" Binding="{Binding Level}" Width="Auto" />
              <DataGridTextColumn Header="{l:Tr Col.Race}" Binding="{Binding RaceName}" Width="*" />
              <DataGridTextColumn Header="{l:Tr Col.Class}" Binding="{Binding ClassName}" Width="*" />
              <DataGridTextColumn Header="{l:Tr Col.Faction}" Binding="{Binding Faction}" Width="Auto" />
              <DataGridTextColumn Header="{l:Tr Col.Map}" Binding="{Binding MapName}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="GmTab" Header="{l:Tr Tab.Gm}">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1"
                  Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel>
              <DockPanel>
                <Button x:Name="EnableSoapButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                        Content="{l:Tr Gm.EnableSoap}" Click="EnableSoapButton_Click" />
                <TextBlock x:Name="SoapStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
              </DockPanel>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{l:Tr Gm.Account}" VerticalAlignment="Center" />
                <TextBox x:Name="SoapUserBox" Width="160" Margin="6,0,0,0" Padding="3,2"
                         VerticalContentAlignment="Center" ToolTip="{l:Tr Gm.Account.Tip}" />
                <TextBlock Text="{l:Tr Gm.Password}" VerticalAlignment="Center" Margin="16,0,0,0" />
                <PasswordBox x:Name="SoapPasswordBox" Width="160" Margin="6,0,0,0" Padding="3,2"
                             VerticalContentAlignment="Center" />
                <Button Content="{l:Tr Common.Save}" Margin="12,0,0,0" Click="SaveSoapButton_Click"
                        ToolTip="{l:Tr Gm.Save.Tip}" />
                <Button Content="{l:Tr Gm.Test}" Margin="8,0,0,0" Tag="run:server info" Click="GmQuickButton_Click"
                        ToolTip="{l:Tr Gm.Test.Tip}" />
              </StackPanel>
              <WrapPanel Margin="0,8,0,0">
                <WrapPanel.Resources>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,4" />
                    <Setter Property="Padding" Value="10,3" />
                    <Setter Property="MinWidth" Value="0" />
                  </Style>
                </WrapPanel.Resources>
                <Button Content="{l:Tr Gm.ServerInfo}" Tag="run:server info" Click="GmQuickButton_Click" />
                <Button Content="{l:Tr Gm.SaveAll}" Tag="run:saveall" Click="GmQuickButton_Click" />
                <Button Content="{l:Tr Gm.Announce}" Tag="fill:announce " Click="GmQuickButton_Click"
                        ToolTip="{l:Tr Gm.Announce.Tip}" />
                <Button Content="{l:Tr Gm.Kick}" Tag="fill:kick " Click="GmQuickButton_Click"
                        ToolTip="{l:Tr Gm.Kick.Tip}" />
                <Button Content="{l:Tr Gm.CreateAccount}" Tag="fill:account create " Click="GmQuickButton_Click"
                        ToolTip="{l:Tr Gm.CreateAccount.Tip}" />
                <Button Content="{l:Tr Gm.SetGm}" Tag="fill:account set gmlevel " Click="GmQuickButton_Click"
                        ToolTip="{l:Tr Gm.SetGm.Tip}" />
                <Button Content="{l:Tr Gm.Reload}" Tag="run:reload config" Click="GmQuickButton_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button x:Name="GmRunButton" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{l:Tr Gm.Run}"
                    Click="GmRunButton_Click" />
            <TextBox x:Name="GmCommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="4,3"
                     PreviewKeyDown="GmCommandBox_PreviewKeyDown" ToolTip="{l:Tr Gm.Command.Tip}" />
          </DockPanel>

          <TextBox x:Name="GmOutputBox" Style="{StaticResource LogBoxStyle}" TextWrapping="Wrap" />
        </DockPanel>
      </TabItem>
      <TabItem x:Name="ConfigTab" Header="{l:Tr Tab.Config}">
        <views:ConfigEditor x:Name="ConfigEditorView" />
      </TabItem>
      <TabItem x:Name="BackupTab" Header="{l:Tr Tab.Backup}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel>
              <TextBlock Text="{l:Tr Backup.Folder}" VerticalAlignment="Center" Width="150" />
              <Button DockPanel.Dock="Right" Content="{l:Tr Backup.OpenFolder}" Margin="8,0,0,0"
                      Click="OpenBackupFolderButton_Click" />
              <Button DockPanel.Dock="Right" Content="{l:Tr Common.Browse}" Margin="8,0,0,0"
                      Click="BackupFolderButton_Click" />
              <TextBox x:Name="BackupFolderBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,3" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="{l:Tr Backup.Databases}" VerticalAlignment="Center" Width="150" />
              <CheckBox x:Name="BackupAuthCheck" Content="{l:Tr Backup.Auth}" VerticalAlignment="Center"
                        Checked="BackupOption_Changed" Unchecked="BackupOption_Changed" />
              <CheckBox x:Name="BackupCharactersCheck" Content="{l:Tr Backup.Characters}" Margin="16,0,0,0"
                        VerticalAlignment="Center" Checked="BackupOption_Changed" Unchecked="BackupOption_Changed" />
              <CheckBox x:Name="BackupWorldCheck" Content="{l:Tr Backup.World}" Margin="16,0,0,0"
                        VerticalAlignment="Center" ToolTip="{l:Tr Backup.World.Tip}"
                        Checked="BackupOption_Changed" Unchecked="BackupOption_Changed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="{l:Tr Backup.Schedule}" VerticalAlignment="Center" Width="150" />
              <ComboBox x:Name="BackupIntervalCombo" Width="160" SelectionChanged="BackupOption_Changed">
                <ComboBoxItem Content="{l:Tr Backup.Off}" Tag="0" />
                <ComboBoxItem Content="{l:Tr Backup.Every1h}" Tag="1" />
                <ComboBoxItem Content="{l:Tr Backup.Every6h}" Tag="6" />
                <ComboBoxItem Content="{l:Tr Backup.Every12h}" Tag="12" />
                <ComboBoxItem Content="{l:Tr Backup.Daily}" Tag="24" />
              </ComboBox>
              <TextBlock Text="{l:Tr Backup.Keep}" VerticalAlignment="Center" Margin="16,0,6,0" />
              <ComboBox x:Name="BackupKeepCombo" Width="90" SelectionChanged="BackupOption_Changed"
                        ToolTip="{l:Tr Backup.Keep.Tip}">
                <ComboBoxItem Content="5" Tag="5" />
                <ComboBoxItem Content="10" Tag="10" />
                <ComboBoxItem Content="20" Tag="20" />
                <ComboBoxItem Content="50" Tag="50" />
                <ComboBoxItem Content="{l:Tr Backup.All}" Tag="0" />
              </ComboBox>
              <Button x:Name="BackupNowButton" Content="{l:Tr Backup.Now}" Margin="16,0,0,0"
                      Click="BackupNowButton_Click" />
            </StackPanel>
            <TextBlock x:Name="BackupStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            <DockPanel Margin="0,4,0,0">
              <Button x:Name="ChooseMysqldumpButton" DockPanel.Dock="Right" Content="{l:Tr Backup.ChooseDump}"
                      Margin="8,0,0,0" Click="ChooseMysqldumpButton_Click" />
              <TextBlock x:Name="MysqldumpText" Foreground="{DynamicResource SubtleTextBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </StackPanel>
          <DataGrid x:Name="BackupsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{l:Tr Col.File}" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="{l:Tr Col.Date}" Binding="{Binding CreatedText}" Width="*" />
              <DataGridTextColumn Header="{l:Tr Col.Size}" Binding="{Binding SizeText}" Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Authserver" />
            <Border Style="{StaticResource ErrorBadge}"
                    Visibility="{Binding HasErrors, ElementName=AuthLogView, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding ErrorCount, ElementName=AuthLogView}" />
            </Border>
          </StackPanel>
        </TabItem.Header>
        <views:LogView x:Name="AuthLogView" FileBaseName="authserver" />
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <CheckBox x:Name="AutoScrollCheck" DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="True"
                Content="{l:Tr Footer.AutoScroll}" Checked="AutoScrollCheck_Changed" Unchecked="AutoScrollCheck_Changed" />
      <CheckBox x:Name="AutoRestartCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="{l:Tr Footer.AutoRestart}"
                Checked="AutoRestartCheck_Changed" Unchecked="AutoRestartCheck_Changed" />
      <CheckBox x:Name="MinimizeToTrayCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="20,0,0,0"
                Content="{l:Tr Footer.MinimizeToTray}" ToolTip="{l:Tr Footer.MinimizeToTray.Tip}"
                Checked="MinimizeToTrayCheck_Changed" Unchecked="MinimizeToTrayCheck_Changed" />
      <Button DockPanel.Dock="Right" Content="{l:Tr Footer.ClearLogs}" Click="ClearLogsButton_Click" />
      <TextBlock />
    </DockPanel>
  </Grid>
</Window>
